# Forge OS — environment configuration
# Copy this file to .env (frontend/Expo) and/or set the same keys as
# Supabase Edge Function secrets. Never commit the real .env file.

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — Edge Functions / server-side only, NEVER ship to the app bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project-ref.supabase.co

# ---- Plant identity ----
PLANT_CODE=VFL-AKT
PLANT_LAT=19.8383935925407
PLANT_LNG=75.23638998304483
PLANT_GEOFENCE_METERS=100

# ---- Claude API (AI suggestions, Varsha AI agent) ----
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Push notifications ----
EXPO_PUSH_ACCESS_TOKEN=your-expo-access-token

# ---- Email integration (n8n / Gmail watchers) ----
GMAIL_SERVICE_ACCOUNT_JSON=path-or-secret-name
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/forge-os

# ---- Zoho Books export ----
ZOHO_BOOKS_ORG_ID=your-org-id

# ---- Misc ----
NODE_ENV=development
